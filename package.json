{
  "name": "aops-store-bnb",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.6",
  "workspaces": {
    "packages": [
      "packages/*",
      "apps/*"
    ],
    "catalog": {
      "@hono/zod-openapi": "^0.18.3",
      "@hono/zod-validator": "^0.4.2",
      "@sentry/node": "^8.47.0",
      "@types/bun": "^1.1.14",
      "@types/node": "^22.10.2",
      "@types/react": "^19.0.2",
      "@types/react-dom": "^19.0.2",
      "drizzle-kit": "^0.30.1",
      "drizzle-orm": "^0.38.3",
      "fast-check": "^3.23.2",
      "hono": "^4.6.14",
      "next": "^15.1.3",
      "pino": "^9.6.0",
      "pino-pretty": "^13.0.0",
      "postgres": "^3.4.5",
      "react": "^19.0.0",
      "react-dom": "^19.0.0",
      "typescript": "^5.7.2",
      "viem": "^2.21.57",
      "zod": "^3.24.1"
    }
  },
  "scripts": {
    "check": "bun run check:boundaries && bun run typecheck",
    "check:boundaries": "bun tooling/check-boundaries.ts",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "biome check .",
    "format": "biome format --write ."
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "@biomejs/biome": "^1.9.4",
    "typescript": "catalog:",
    "@types/bun": "catalog:"
  }
}
