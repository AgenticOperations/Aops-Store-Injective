{
  "name": "aops-store-bnb",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": {
    "packages": [
      "packages/*",
      "apps/*"
    ],
    "catalog": {
      "typescript": "^5.7.2",
      "@types/bun": "^1.1.14",
      "zod": "^3.24.1"
    }
  },
  "scripts": {
