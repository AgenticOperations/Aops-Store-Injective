{
  "name": "aops-store-bnb",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.6",
  "workspaces": {
    "packages": ["packages/*", "apps/*"],
    "catalog": {
      "@hono/zod-openapi": "^0.18.3",
      "@hono/zod-validator": "^0.4.2",
      "@sentry/node": "^8.47.0",
      "@types/bun": "^1.1.14",
      "@types/node": "^22.10.2",
      "@types/react": "^19.0.2",
      "@types/react-dom": "^19.0.2",
      "drizzle-kit": "^0.30.1",
      "drizzle-orm": "^0.38.3",
      "fast-check": "^3.23.2",
      "hono": "^4.6.14",
      "next": "^15.1.3",
      "pino": "^9.6.0",
      "pino-pretty": "^13.0.0",
      "postgres": "^3.4.5",
      "react": "^19.0.0",
      "react-dom": "^19.0.0",
      "typescript": "^5.7.2",
      "viem": "^2.21.57",
      "zod": "^3.24.1"
    }
  },
  "scripts": {
    "dev": "turbo run dev",
    "start": "turbo run start",
    "build": "turbo run build",
    "dev:web": "turbo run dev --filter=@app/web",
    "dev:console": "turbo run dev --filter=@app/console",
    "dev:api": "turbo run dev --filter=@app/api",
    "dev:jobs": "turbo run dev --filter=@app/jobs",
    "dev:watch": "turbo run dev --filter=@app/watch",
    "dev:human": "turbo run dev --filter=@app/web --filter=@app/console --filter=@app/api",
    "dev:batch": "turbo run dev --filter=@app/jobs",
    "dev:continuous": "turbo run dev --filter=@app/watch",
    "start:web": "turbo run start --filter=@app/web",
    "start:console": "turbo run start --filter=@app/console",
    "start:api": "turbo run start --filter=@app/api",
    "start:jobs": "turbo run start --filter=@app/jobs",
    "start:watch": "turbo run start --filter=@app/watch",
    "check": "bun run check:boundaries && bun run typecheck && bun run lint",
    "check:boundaries": "bun tooling/check-boundaries.ts",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "biome check .",
    "format": "biome format --write .",
    "db:generate": "turbo run db:generate --filter=@repo/database",
    "db:migrate": "turbo run db:migrate --filter=@repo/database",
    "clean": "rm -rf node_modules .turbo **/.turbo **/node_modules **/.next"
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "@biomejs/biome": "^1.9.4",
    "typescript": "catalog:",
    "@types/bun": "catalog:"
  }
}
