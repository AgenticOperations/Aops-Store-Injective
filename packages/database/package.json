{
  "name": "@repo/database",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "ring": 2,
  "imports": {
    "#public/*": "./public/*.ts",
    "#private/*": "./private/*.ts"
  },
  "exports": {
    "./client": "./public/client.ts",
    "./schema": "./public/schema.ts",
    "./keys": "./public/keys.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:setup-app-role": "bun scripts/setup-app-role.ts"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "@types/bun": "catalog:",
    "drizzle-kit": "catalog:"
  },
  "dependencies": {
    "@repo/domain": "workspace:*",
    "drizzle-orm": "catalog:",
    "postgres": "catalog:",
    "zod": "catalog:"
  }
}
