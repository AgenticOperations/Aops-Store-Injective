# Copy to `.env` at this directory (repo root). Gitignored — never commit secrets.
#
# Required for @app/watch, @app/jobs, @app/api (Postgres via @repo/database).
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# Optional — @app/watch (defaults shown in apps/watch/src/config.ts)
# WATCH_NETWORK=testnet
# WATCH_POOL_ADDRESS=0x6805E0E5333c5c3acCF2930Be4734E2b98f4Ce06
# WATCH_POOL_INTERVAL_MS=60000
# WATCH_ENDPOINT_INTERVAL_MS=120000

# Optional — @app/api
# PORT=3001
# API_BASE_URL=http://localhost:3001
# ACCESS_NET=tbsc

# Optional — BSC RPC overrides (@repo/market-data; public defaults exist)
# BSC_TESTNET_RPC_URL=https://bsc-testnet-dataseed.bnbchain.org
# BSC_MAINNET_RPC_URL=https://bsc-dataseed.bnbchain.org
